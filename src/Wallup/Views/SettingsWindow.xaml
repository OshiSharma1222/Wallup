<Window x:Class="Wallup.Views.SettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Wallup.Views"
        Title="Wallup"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="360"
        Topmost="True"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <views:EnumMatchConverter x:Key="Is" />
        <views:EmptyToVisibleConverter x:Key="EmptyToVisible" />

        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="Rule" TargetType="Rectangle">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,14,0,14" />
            <Setter Property="Fill" Value="{DynamicResource Hairline}" />
        </Style>

        <!-- Plain text, not ChipLabel: that one carries a shadow for reading over any
             wallpaper, which this panel's own wash makes unnecessary. -->
        <Style x:Key="RowText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
                    <Setter Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Choice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <!-- Ticking a row moves it between the lists and takes its chip off the desktop,
             exactly like ticking the chip. Unticking a done one puts the chip back. -->
        <DataTemplate x:Key="ToDoRow">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Style="{DynamicResource TaskCheck}" IsChecked="{Binding IsDone}"
                          Margin="0,0,10,0" VerticalAlignment="Top" />
                <TextBlock Grid.Column="1" Style="{StaticResource RowText}" Text="{Binding Text}" />
                <TextBlock Grid.Column="2" Style="{DynamicResource Caption}" Margin="10,2,0,0"
                           VerticalAlignment="Top" ToolTip="Made on"
                           Text="{Binding CreatedAt, StringFormat='d MMM'}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DoneRow">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Style="{DynamicResource TaskCheck}" IsChecked="{Binding IsDone}"
                          Margin="0,0,10,0" VerticalAlignment="Top" />
                <TextBlock Grid.Column="1" Style="{StaticResource RowText}" Text="{Binding Text}" />
                <TextBlock Grid.Column="2" Style="{DynamicResource Caption}" Margin="10,2,0,0"
                           VerticalAlignment="Top" ToolTip="Done at"
                           Text="{Binding CompletedAt, StringFormat='HH:mm'}" />
            </Grid>
        </DataTemplate>

        <!-- An empty list says so, instead of leaving a gap under its heading. -->
        <Style x:Key="EmptyNote" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontStyle" Value="Italic" />
        </Style>
    </Window.Resources>

    <Border Style="{DynamicResource GlassSurface}">
        <StackPanel Margin="18,16,18,16" MouseLeftButtonDown="OnDrag">

            <!-- Today -->
            <Grid Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Section}" Text="TODAY" />
                    <TextBlock x:Name="TodayLabel" Style="{DynamicResource Caption}"
                               Margin="8,0,0,0" />
                </StackPanel>
                <Button Style="{DynamicResource GhostButton}" Content="done"
                        HorizontalAlignment="Right" Click="OnDoneClick"
                        Foreground="{DynamicResource Accent}" />
            </Grid>

            <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{DynamicResource Caption}" Text="To do" />
                    <ItemsControl x:Name="ToDoList" ItemsSource="{Binding ToDo}"
                                  ItemTemplate="{StaticResource ToDoRow}" />
                    <TextBlock Style="{StaticResource EmptyNote}" Text="Nothing left to do."
                               Visibility="{Binding HasItems, ElementName=ToDoList,
                                            Converter={StaticResource EmptyToVisible}}" />

                    <TextBlock Style="{DynamicResource Caption}" Text="Done" Margin="0,12,0,0" />
                    <ItemsControl x:Name="DoneList" ItemsSource="{Binding DoneToday}"
                                  ItemTemplate="{StaticResource DoneRow}" />
                    <TextBlock Style="{StaticResource EmptyNote}" Text="Nothing ticked off yet."
                               Visibility="{Binding HasItems, ElementName=DoneList,
                                            Converter={StaticResource EmptyToVisible}}" />
                </StackPanel>
            </ScrollViewer>

            <Rectangle Style="{StaticResource Rule}" />

            <!-- Gesture -->
            <TextBlock Style="{StaticResource Section}" Text="OPEN THE TASK BOX WITH"
                       Margin="0,0,0,10" />

            <RadioButton Style="{StaticResource Choice}"
                         Content="Double right-click on the desktop"
                         IsChecked="{Binding Settings.OpenWith, Converter={StaticResource Is},
                                     ConverterParameter=RightClick}" />
            <RadioButton Style="{StaticResource Choice}"
                         Content="Ctrl + Alt, pressed on their own"
                         IsChecked="{Binding Settings.OpenWith, Converter={StaticResource Is},
                                     ConverterParameter=CtrlAlt}" />
            <RadioButton Style="{StaticResource Choice}" Content="Both"
                         IsChecked="{Binding Settings.OpenWith, Converter={StaticResource Is},
                                     ConverterParameter=Both}" />

            <Rectangle Style="{StaticResource Rule}" />

            <!-- Appearance -->
            <!-- The differentiator from Rainmeter: sliders, not an .ini file. -->
            <TextBlock Style="{StaticResource Section}" Text="APPEARANCE" Margin="0,0,0,10" />

            <TextBlock Style="{DynamicResource Caption}" Text="Opacity" />
            <Slider Minimum="0.25" Maximum="1.0" Value="{Binding Settings.Opacity}"
                    Margin="0,5,0,15" />

            <TextBlock Style="{DynamicResource Caption}" Text="Text size" />
            <Slider Minimum="9" Maximum="28" TickFrequency="1" IsSnapToTickEnabled="True"
                    Value="{Binding Settings.FontSize}" Margin="0,5,0,15" />

            <TextBlock Style="{DynamicResource Caption}" Text="Chip width" />
            <Slider Minimum="140" Maximum="520" TickFrequency="10" IsSnapToTickEnabled="True"
                    Value="{Binding Settings.ChipWidth}" Margin="0,5,0,0" />

        </StackPanel>
    </Border>
</Window>
