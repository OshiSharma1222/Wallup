<Window x:Class="Wallup.Views.SettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wallup settings"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="320"
        Topmost="True"
        WindowStartupLocation="CenterScreen">

    <!-- The differentiator from Rainmeter: sliders, not an .ini file. Every change lands
         on the chips live and is written out when the panel closes. -->
    <Grid Margin="16,14,16,14" MouseLeftButtonDown="OnDrag">
        <StackPanel>

            <Grid Margin="0,0,0,14">
                <TextBlock Style="{StaticResource Caption}" Text="APPEARANCE" FontWeight="SemiBold" />
                <Button Style="{StaticResource GhostButton}" Content="done"
                        HorizontalAlignment="Right" Click="OnDoneClick" />
            </Grid>

            <TextBlock Style="{StaticResource Caption}" Text="Opacity" />
            <Slider Minimum="0.25" Maximum="1.0" Value="{Binding Settings.Opacity}"
                    Margin="0,4,0,14" />

            <TextBlock Style="{StaticResource Caption}" Text="Text size" />
            <Slider Minimum="9" Maximum="28" TickFrequency="1" IsSnapToTickEnabled="True"
                    Value="{Binding Settings.FontSize}" Margin="0,4,0,14" />

            <TextBlock Style="{StaticResource Caption}" Text="Chip width" />
            <Slider Minimum="140" Maximum="520" TickFrequency="10" IsSnapToTickEnabled="True"
                    Value="{Binding Settings.ChipWidth}" Margin="0,4,0,14" />

            <CheckBox Content="Take finished tasks off the desktop"
                      Foreground="{StaticResource InkMuted}" FontSize="12"
                      IsChecked="{Binding Settings.HideCompleted}" />

        </StackPanel>
    </Grid>
</Window>
