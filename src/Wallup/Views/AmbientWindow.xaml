<Window x:Class="Wallup.Views.AmbientWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Wallup.Models"
        Title="Wallup"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Focusable="False"
        IsHitTestVisible="False"
        Opacity="{Binding Settings.Opacity}">

    <!-- This window is parented into the WorkerW layer, so it can never receive input.
         It is a pure render surface; every interaction happens in TaskBoxWindow. -->
    <Border Style="{StaticResource BoxChrome}">
        <DockPanel>

            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}"
                       Text="WALLUP" FontWeight="SemiBold" Margin="2,0,0,10" />

            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}"
                       Margin="2,10,0,0" Text="right-click the desktop to add" />

            <ItemsControl ItemsSource="{Binding VisibleTasks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:TaskItem}">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" Style="{StaticResource TaskCheck}"
                                      IsChecked="{Binding IsDone, Mode=OneWay}"
                                      Margin="2,1,10,0" VerticalAlignment="Top" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Text}"
                                       FontSize="{Binding DataContext.Settings.FontSize,
                                                  RelativeSource={RelativeSource AncestorType=Window}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TaskText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                <Setter Property="Opacity" Value="0.45" />
                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </DockPanel>
    </Border>
</Window>
