<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light vibrancy, for glass sitting on a bright wallpaper. Same structure as the
         dark set; only the tones differ. -->

    <SolidColorBrush x:Key="Ink" Color="#F2101418" />
    <SolidColorBrush x:Key="InkMuted" Color="#8C101418" />
    <SolidColorBrush x:Key="InkFaint" Color="#59101418" />
    <SolidColorBrush x:Key="Accent" Color="#FF007AFF" />
    <SolidColorBrush x:Key="Hairline" Color="#26101418" />
    <SolidColorBrush x:Key="CheckRim" Color="#73101418" />
    <SolidColorBrush x:Key="CheckFill" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="Hover" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="PopupBack" Color="#F2F7F9FC" />
    <SolidColorBrush x:Key="FieldBack" Color="#14101418" />

    <LinearGradientBrush x:Key="Rim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2FFFFFF" Offset="0" />
        <GradientStop Color="#8CFFFFFF" Offset="0.4" />
        <GradientStop Color="#59FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Sheen" StartPoint="0.05,0" EndPoint="0.8,1">
        <GradientStop Color="#C7FFFFFF" Offset="0" />
        <GradientStop Color="#ADFFFFFF" Offset="0.3" />
        <GradientStop Color="#9EFFFFFF" Offset="0.68" />
        <GradientStop Color="#AAFFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TopLight" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#A6FFFFFF" Offset="0" />
        <GradientStop Color="#33FFFFFF" Offset="0.5" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
