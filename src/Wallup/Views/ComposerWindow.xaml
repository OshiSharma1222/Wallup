<Window x:Class="Wallup.Views.ComposerWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wallup"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="540"
        Height="112"
        Topmost="True"
        WindowStartupLocation="Manual"
        PreviewKeyDown="OnInputKeyDown"
        PreviewMouseRightButtonDown="OnRightButtonDown">

    <!-- The Flow bar: a dark pill resting just above the taskbar, in the manner of Wispr
         Flow. It grows out of a sliver when it opens and shrinks back into one when it
         closes; ComposerWindow.xaml.cs drives both. The window is larger than the pill so
         the shadow has somewhere to fall. -->
    <Grid x:Name="Pill" Width="56" Height="10"
          HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20">

        <!-- The shadow on a layer of its own: an effect on the face would also soften
             the text it carries. -->
        <Border CornerRadius="23" Background="#FF0B0B0D">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="7" Direction="270"
                                  Opacity="0.42" Color="#000000" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="23" BorderThickness="1" BorderBrush="#2EFFFFFF">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#FF1C1C20" />
                    <GradientStop Offset="1" Color="#FF0B0B0D" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid x:Name="Face" Opacity="0" Margin="18,0,9,0" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Wispr's waveform answers your voice; this one answers your typing. The bar
                 heights are set from the code-behind. -->
            <StackPanel x:Name="Wave" Grid.Column="0" Orientation="Horizontal"
                        VerticalAlignment="Center" Height="18">
                <StackPanel.Resources>
                    <Style TargetType="Rectangle">
                        <Setter Property="Width" Value="3" />
                        <Setter Property="Height" Value="4" />
                        <Setter Property="RadiusX" Value="1.5" />
                        <Setter Property="RadiusY" Value="1.5" />
                        <Setter Property="Margin" Value="1.5,0" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Fill" Value="#F2FFFFFF" />
                    </Style>
                </StackPanel.Resources>
                <Rectangle />
                <Rectangle />
                <Rectangle />
                <Rectangle />
                <Rectangle />
            </StackPanel>

            <Grid Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                <TextBlock x:Name="Placeholder" Text="Add a task…"
                           Foreground="#73FFFFFF" FontSize="15" Margin="2,0,0,0"
                           IsHitTestVisible="False" VerticalAlignment="Center" />

                <!-- No context menu: its first right-click would swallow the double
                     right-click that cancels the box. Keyboard shortcuts still work. -->
                <TextBox x:Name="Input"
                         ContextMenuService.IsEnabled="False"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         Foreground="#FFFFFFFF" CaretBrush="#FFFFFFFF"
                         SelectionBrush="#80FFFFFF" FontSize="15"
                         FocusVisualStyle="{x:Null}" VerticalContentAlignment="Center"
                         TextChanged="OnInputTextChanged" />
            </Grid>

            <!-- A keycap for the one key that matters. -->
            <Border Grid.Column="2" CornerRadius="14" Height="28" MinWidth="28" Padding="9,0"
                    Background="#1FFFFFFF" VerticalAlignment="Center">
                <TextBlock Text="↵" Foreground="#B3FFFFFF" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Grid>
</Window>
