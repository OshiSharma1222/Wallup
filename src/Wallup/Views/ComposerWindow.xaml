<Window x:Class="Wallup.Views.ComposerWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Wallup.Views"
        Title="Wallup"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="338"
        Topmost="True"
        WindowStartupLocation="Manual"
        PreviewKeyDown="OnInputKeyDown">

    <!-- Same glass as a chip, because this is what the chip is about to become. The margin
         is room for the cast shadow; see ChipWindow. -->
    <Grid Margin="14">
        <views:GlassCapsule Padding="20,14,20,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" x:Name="Input"
                         Style="{DynamicResource GlassText}"
                         FontSize="16" />

                <Rectangle Grid.Row="1" Height="1" Margin="0,9,0,0"
                           Fill="{DynamicResource Hairline}" />

                <TextBlock Grid.Row="2" Style="{DynamicResource Caption}" Margin="0,8,0,0"
                           Text="enter to drop it on the desktop  ·  esc to cancel" />
            </Grid>
        </views:GlassCapsule>
    </Grid>
</Window>
