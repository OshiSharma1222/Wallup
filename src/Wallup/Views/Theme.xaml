<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:Wallup.Views">

    <!-- Structure only. Every colour is a DynamicResource so each window can merge either
         GlassDark or GlassLight into its own resources once it has sampled the wallpaper
         behind it. A StaticResource would bake in whichever set loaded first. -->

    <!-- Wraps a window's content: sits on the DWM acrylic and supplies the wash, the rim
         and the corner radius. Only the settings panel uses this now; it floats over other
         apps, where the system's own blur is the honest thing to show. -->
    <Style x:Key="GlassSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Sheen}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Rim}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- The glass itself. Layer order is the whole trick, bottom to top:
         the cast shadow, the refracted wallpaper, the hard-magnified rim band, the wash
         that keeps text readable, the top sheen, a colour fringe, and the bright outline.
         Everything that would spill past the pill lives inside PART_Clip. -->
    <Style TargetType="{x:Type views:GlassCapsule}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <!-- A sheet of glass is not a focus stop. Without this, closing the inline editor
             hands focus up to the capsule and WPF draws a dashed rectangle on it. -->
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:GlassCapsule}">
                    <Grid>
                        <!-- Sits underneath the refracted picture, which is opaque, so only
                             the spill around the edge is ever seen. -->
                        <Border x:Name="PART_Shadow" Background="#B2000000"
                                CornerRadius="{TemplateBinding CornerCurve}" Margin="0,1,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270"
                                                  Opacity="0.36" Color="#000000" />
                            </Border.Effect>
                        </Border>

                        <Grid x:Name="PART_Clip">
                            <!-- The wallpaper behind the glass, gently magnified. The negative
                                 margin gives the blur material to chew on past the edge. -->
                            <Rectangle x:Name="PART_Core" Margin="-24">
                                <Rectangle.Effect>
                                    <BlurEffect Radius="6" KernelType="Gaussian" />
                                </Rectangle.Effect>
                            </Rectangle>

                            <!-- The thick edge of the lens: the same picture, squeezed hard,
                                 painted only in a band because a border paints only its ring. -->
                            <Border x:Name="PART_Edge" BorderThickness="13"
                                    CornerRadius="{TemplateBinding CornerCurve}">
                                <Border.Effect>
                                    <BlurEffect Radius="2" KernelType="Gaussian" />
                                </Border.Effect>
                            </Border>

                            <Rectangle Fill="{DynamicResource Sheen}" />
                            <Rectangle Fill="{DynamicResource TopLight}" />
                        </Grid>

                        <!-- Light splitting as it leaves the glass. Barely there on purpose:
                             at full strength it reads as a rendering fault, not as glass. -->
                        <Border Margin="1.5" BorderThickness="1.2" Opacity="0.75"
                                CornerRadius="{TemplateBinding CornerCurve}"
                                BorderBrush="{DynamicResource Fringe}">
                            <Border.Effect>
                                <BlurEffect Radius="1.6" KernelType="Gaussian" />
                            </Border.Effect>
                        </Border>

                        <Border BorderThickness="1" CornerRadius="{TemplateBinding CornerCurve}"
                                BorderBrush="{DynamicResource Rim}" />

                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- Text that lives directly on glass. Background is {x:Null}, not Transparent: a
         transparent brush still writes pixels, and over a DWM-extended frame those show
         the raw backdrop instead of the wash, which reads as a dull panel. -->
    <Style x:Key="GlassText" TargetType="TextBox">
        <Setter Property="Background" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
        <Setter Property="SelectionOpacity" Value="0.3" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                  Background="{x:Null}" BorderThickness="0"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Chip text at rest. A label, not a text box: a TextBox drags its own chrome onto
         the glass. The done state dims the brush rather than setting Opacity, because
         Opacity forces WPF into a separate layer whose bounds show through the glass. -->
    <Style x:Key="ChipLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <!-- Clear glass means the wallpaper can be any colour right under a letter. A soft
             shadow in the opposite tone is what keeps the text readable there. -->
        <Setter Property="Effect" Value="{DynamicResource InkShadow}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsDone}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource InkFaint}" />
                <Setter Property="TextDecorations" Value="Strikethrough" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A tick that reads as a task marker, not a Win32 control. -->
    <Style x:Key="TaskCheck" TargetType="CheckBox">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Box" Width="17" Height="17" CornerRadius="9"
                            BorderBrush="{DynamicResource CheckRim}" BorderThickness="1.3"
                            Background="{DynamicResource CheckFill}" SnapsToDevicePixels="True">
                        <Path x:Name="Tick" Data="M 2.5,6.5 L 5.5,9.5 L 11,3.5"
                              Stroke="White" StrokeThickness="2"
                              StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                              StrokeLineJoin="Round" Visibility="Collapsed" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
        <Setter Property="Background" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
