<Window x:Class="Wallup.Views.TaskBoxWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Wallup.Models"
        Title="Wallup"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="340"
        Topmost="True"
        WindowStartupLocation="Manual">

    <Border Style="{StaticResource BoxChrome}" Background="#F00F1319">
        <DockPanel>

            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock Style="{StaticResource Caption}" Text="NEW TASK" FontWeight="SemiBold" />
                <Button Style="{StaticResource GhostButton}" Content="settings"
                        HorizontalAlignment="Right" Click="OnSettingsClick" />
            </Grid>

            <Border DockPanel.Dock="Top" CornerRadius="8" Background="#1AFFFFFF"
                    Padding="10,7" Margin="0,0,0,12">
                <TextBox x:Name="Input"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource Ink}" CaretBrush="{StaticResource Accent}"
                         FontSize="14"
                         Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnInputKeyDown" />
            </Border>

            <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <TextBlock Style="{StaticResource Caption}" Text="enter to add  ·  esc to close" />
                <Button Style="{StaticResource GhostButton}" Content="clear done"
                        HorizontalAlignment="Right"
                        Command="{Binding ClearCompletedCommand}" />
            </Grid>

            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Tasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:TaskItem}">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" Style="{StaticResource TaskCheck}"
                                          IsChecked="{Binding IsDone}" Margin="2,0,10,0" />

                                <TextBox Grid.Column="1"
                                         Text="{Binding Text, UpdateSourceTrigger=LostFocus}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource Ink}"
                                         CaretBrush="{StaticResource Accent}"
                                         FontSize="13" VerticalAlignment="Center">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <Button Grid.Column="2" Style="{StaticResource GhostButton}"
                                        Content="×" FontSize="15"
                                        Command="{Binding DataContext.DeleteCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </DockPanel>
    </Border>
</Window>
