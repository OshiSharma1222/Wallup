<Window x:Class="Wallup.Views.ChipWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wallup task"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="250"
        WindowStartupLocation="Manual">

    <!-- AllowsTransparency stays False so DWM will paint acrylic behind us. A layered
         window gets no backdrop, which is the usual reason glass silently does nothing. -->
    <Border Style="{StaticResource GlassSurface}">
        <Grid>
            <Border VerticalAlignment="Top" Height="18" CornerRadius="10,10,0,0"
                    Background="{StaticResource TopLight}" IsHitTestVisible="False" />

        <Grid x:Name="Root" Margin="12,9,10,10" MouseLeftButtonDown="OnDragStart">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Column="0" Style="{StaticResource TaskCheck}"
                      IsChecked="{Binding IsDone}" Margin="0,1,10,0"
                      VerticalAlignment="Top" />

            <!-- Label at rest, editor on double-click. Swapping beats one TextBox with a
                 transparent background, which still paints its own panel on the glass. -->
            <Grid Grid.Column="1">
                <TextBlock x:Name="Label" Style="{StaticResource ChipLabel}"
                           Text="{Binding Text}" FontSize="14"
                           MouseLeftButtonDown="OnLabelClick" />

                <TextBox x:Name="Editor" Style="{StaticResource GlassText}"
                         Text="{Binding Text, UpdateSourceTrigger=LostFocus}"
                         FontSize="14" TextWrapping="Wrap" AcceptsReturn="False"
                         VerticalAlignment="Center" Visibility="Collapsed"
                         KeyDown="OnEditorKeyDown" LostFocus="OnEndEdit" />
            </Grid>

            <!-- Controls stay out of the way until the chip is hovered. -->
            <StackPanel Grid.Column="2" x:Name="Actions" Orientation="Horizontal"
                        VerticalAlignment="Top" Margin="8,0,0,0" Opacity="0">
                <Button Style="{StaticResource GhostButton}" Click="OnClockClick"
                        ToolTip="Set an alarm" Padding="3,1">
                    <Path Width="13" Height="13" Stretch="Uniform"
                          Stroke="{StaticResource InkMuted}" StrokeThickness="1.4"
                          Data="M 8,1 A 7,7 0 1 1 7.99,1 Z M 8,4 L 8,8 L 11,10" />
                </Button>
                <Button Style="{StaticResource GhostButton}" Click="OnDeleteClick"
                        ToolTip="Delete" Padding="3,1">
                    <Path Width="10" Height="10" Stretch="Uniform"
                          Stroke="{StaticResource InkMuted}" StrokeThickness="1.6"
                          StrokeEndLineCap="Round"
                          Data="M 1,1 L 11,11 M 11,1 L 1,11" />
                </Button>
            </StackPanel>

            <!-- Alarm editor, opened by the clock button. -->
            <Popup x:Name="AlarmPopup" PlacementTarget="{Binding ElementName=Actions}"
                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                   HorizontalOffset="-70" VerticalOffset="6">
                <Border Background="#F2F7F9FC" CornerRadius="10" Padding="12"
                        BorderBrush="#40000000" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="ALARM AT"
                                   FontWeight="SemiBold" Margin="0,0,0,7" />
                        <Border Background="#14101418" CornerRadius="7" Padding="8,5">
                            <TextBox x:Name="AlarmInput" Width="86" FontSize="15"
                                     Style="{StaticResource GlassText}"
                                     KeyDown="OnAlarmKeyDown" />
                        </Border>
                        <TextBlock Style="{StaticResource Caption}" Text="24h, e.g. 14:30"
                                   Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    Margin="0,9,0,0">
                            <Button Style="{StaticResource GhostButton}" Content="clear"
                                    Click="OnAlarmClear" />
                            <Button Style="{StaticResource GhostButton}" Content="set"
                                    Click="OnAlarmSet" Foreground="{StaticResource Accent}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
        </Grid>
    </Border>
</Window>
