<Window x:Class="Wallup.Views.ChipWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Wallup.Views"
        Title="Wallup task"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="328"
        WindowStartupLocation="Manual">

    <!-- Per-pixel transparency, unlike the settings panel. A capsule cannot be cut out of
         an opaque window, and DWM's acrylic refuses to draw behind a layered one - so the
         glass paints the wallpaper itself. See GlassCapsule. -->

    <!-- The margin is the room the cast shadow needs; the capsule is inset by it, so the
         window is Halo wider on each side than the chip you can see. -->
    <Grid Margin="14">
        <views:GlassCapsule Padding="17,10,14,11">
            <Grid x:Name="Root" MouseLeftButtonDown="OnDragStart">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0" Style="{DynamicResource TaskCheck}"
                          IsChecked="{Binding IsDone}" Margin="0,1,10,0"
                          VerticalAlignment="Top" />

                <!-- Label at rest, editor on double-click. Swapping beats one TextBox with a
                     transparent background, which still paints its own panel on the glass. -->
                <Grid Grid.Column="1">
                    <TextBlock x:Name="Label" Style="{DynamicResource ChipLabel}"
                               Text="{Binding Text}" FontSize="14"
                               MouseLeftButtonDown="OnLabelClick" />

                    <TextBox x:Name="Editor" Style="{DynamicResource GlassText}"
                             Text="{Binding Text, UpdateSourceTrigger=LostFocus}"
                             FontSize="14" TextWrapping="Wrap" AcceptsReturn="False"
                             VerticalAlignment="Center" Visibility="Collapsed"
                             KeyDown="OnEditorKeyDown" LostFocus="OnEndEdit" />
                </Grid>

                <!-- The day the task was made sits in the corner at rest; hovering swaps
                     it for the controls, which share the same spot. -->
                <TextBlock Grid.Column="2" x:Name="Created" Style="{DynamicResource Caption}"
                           Text="{Binding CreatedAt, StringFormat='d MMM'}"
                           HorizontalAlignment="Right" VerticalAlignment="Top"
                           Margin="8,2,0,0" IsHitTestVisible="False" />

                <!-- Controls stay out of the way until the chip is hovered. -->
                <StackPanel Grid.Column="2" x:Name="Actions" Orientation="Horizontal"
                            VerticalAlignment="Top" Margin="8,0,0,0" Opacity="0">
                    <Button Style="{DynamicResource GhostButton}" Click="OnClockClick"
                            ToolTip="Set an alarm" Padding="3,1">
                        <Path Width="13" Height="13" Stretch="Uniform"
                              Stroke="{DynamicResource InkMuted}" StrokeThickness="1.4"
                              Data="M 8,1 A 7,7 0 1 1 7.99,1 Z M 8,4 L 8,8 L 11,10" />
                    </Button>
                    <Button Style="{DynamicResource GhostButton}" Click="OnDeleteClick"
                            ToolTip="Delete" Padding="3,1">
                        <Path Width="10" Height="10" Stretch="Uniform"
                              Stroke="{DynamicResource InkMuted}" StrokeThickness="1.6"
                              StrokeEndLineCap="Round"
                              Data="M 1,1 L 11,11 M 11,1 L 1,11" />
                    </Button>
                </StackPanel>

                <!-- Alarm editor, opened by the clock button. -->
                <Popup x:Name="AlarmPopup" PlacementTarget="{Binding ElementName=Actions}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                       HorizontalOffset="-70" VerticalOffset="6">
                    <Border Background="{DynamicResource PopupBack}" CornerRadius="10" Padding="12"
                            BorderBrush="{DynamicResource Hairline}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Caption}" Text="ALARM AT"
                                       FontWeight="SemiBold" Margin="0,0,0,7" />
                            <Border Background="{DynamicResource FieldBack}" CornerRadius="7" Padding="8,5">
                                <TextBox x:Name="AlarmInput" Width="86" FontSize="15"
                                         Style="{DynamicResource GlassText}"
                                         KeyDown="OnAlarmKeyDown" />
                            </Border>
                            <TextBlock Style="{DynamicResource Caption}" Text="24h, e.g. 14:30"
                                       Margin="0,6,0,0" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                        Margin="0,9,0,0">
                                <Button Style="{DynamicResource GhostButton}" Content="clear"
                                        Click="OnAlarmClear" />
                                <Button Style="{DynamicResource GhostButton}" Content="set"
                                        Click="OnAlarmSet" Foreground="{DynamicResource Accent}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </views:GlassCapsule>
    </Grid>
</Window>
