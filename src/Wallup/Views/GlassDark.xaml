<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark vibrancy, for glass sitting on a dark wallpaper. Smoked rather than black, so
         the wallpaper still reads through it, with a bright rim to catch the edge. -->

    <SolidColorBrush x:Key="Ink" Color="#F7FFFFFF" />
    <SolidColorBrush x:Key="InkMuted" Color="#8FFFFFFF" />
    <SolidColorBrush x:Key="InkFaint" Color="#59FFFFFF" />
    <SolidColorBrush x:Key="Accent" Color="#FF0A84FF" />
    <SolidColorBrush x:Key="Hairline" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="CheckRim" Color="#7AFFFFFF" />
    <SolidColorBrush x:Key="CheckFill" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="Hover" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="PopupBack" Color="#F2181C22" />
    <SolidColorBrush x:Key="FieldBack" Color="#1FFFFFFF" />

    <LinearGradientBrush x:Key="Rim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#75FFFFFF" Offset="0" />
        <GradientStop Color="#2EFFFFFF" Offset="0.45" />
        <GradientStop Color="#1FFFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- The smoke. Light enough to keep text crisp, sheer enough that the wallpaper
         still shows through the blur. -->
    <LinearGradientBrush x:Key="Sheen" StartPoint="0.05,0" EndPoint="0.8,1">
        <GradientStop Color="#8C1A1F26" Offset="0" />
        <GradientStop Color="#A6141820" Offset="0.35" />
        <GradientStop Color="#B00F131A" Offset="0.72" />
        <GradientStop Color="#A6141820" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TopLight" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4DFFFFFF" Offset="0" />
        <GradientStop Color="#14FFFFFF" Offset="0.5" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
